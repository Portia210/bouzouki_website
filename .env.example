# Copy to .env and fill in real values. This file is committed — NEVER put real
# secrets here. Every variable the app reads is listed, with a dummy value.

# Flask session/signing key (required — app.py refuses to start without it)
FLASK_SECRET_KEY=replace-me-with-a-long-random-string

# Port for `python app.py` (Heroku sets it automatically)
PORT=5000

# DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=INFO

# Railway runs behind one proxy: set to 1 so rate limiting sees the real client IP.
# Leave 0 locally.
TRUST_PROXY_HOPS=0

# Optional: SQLite file to use instead of instance/music.db (e.g. a Railway volume path)
# DATABASE_PATH=/data/music.db

# Optional: shared rate-limit storage (default memory:// is per worker)
# RATELIMIT_STORAGE_URI=redis://localhost:6379
