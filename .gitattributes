# Normalize line endings: LF in the repo and working tree.
# Critical on Windows/WSL — a hook script checked out with CRLF fails to run.
* text=auto eol=lf

*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary — never diff or convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary

# Lockfiles: don't show in diffs by default, treat as generated
pnpm-lock.yaml    -diff linguist-generated
package-lock.json -diff linguist-generated
yarn.lock         -diff linguist-generated
uv.lock           -diff linguist-generated
poetry.lock       -diff linguist-generated
